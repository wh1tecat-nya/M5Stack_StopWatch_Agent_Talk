+static bool token_bytes(const uint8_t *data, size_t length) {
+    for (size_t i = 0; i < length; i++)
+        if (data[i] < '!' || data[i] > '~') return false;
+    return true;
+}
+
+int app_sumi_muse_commit(const char *peer, const uint8_t *bytes, size_t length) {
+    if (length < 12) return 0;
+    if (!auth_try()) return -1;
+    sumi_muse_pair_t *current = malloc(sizeof(*current));
+    sumi_muse_pair_t *next = calloc(1, sizeof(*next));
+    uint8_t digest[32];
+    size_t access = bytes[8] | (size_t)bytes[9] << 8;
+    size_t refresh = bytes[10] | (size_t)bytes[11] << 8;
+    int result = 0;
+    if (access >= 10 && refresh && access < SUMI_MUSE_TOKEN_CAP && refresh < SUMI_MUSE_TOKEN_CAP &&
+        length == 12 + access + refresh && token_bytes(bytes + 12, access + refresh) &&
+        current && next && muse_peer_matches(peer) &&
+        config_sumi_muse_load(current) && current->reserved && muse_revision(current, digest) &&
+        memcmp(digest, bytes, SUMI_MUSE_REV_BYTES) == 0) {
+        memcpy(next->access, bytes + 12, access);
+        memcpy(next->refresh, bytes + 12 + access, refresh);
+        result = store_token_pair_unlocked(next->access, next->refresh) ? 1 : -2;
+    }
+    free_muse_pair(next);
+    free_muse_pair(current);
+    auth_lock_give();
+    return result;
+}
+
+bool app_sumi_wifi_begin(void) {
+    return operation_gate_take(0, "Sumi Wi-Fi settings");
+}
+
+void app_sumi_wifi_leave(void) {
+    s_muse_resume_vm = s_muse_resume_vm || noise_ctrl_is_running();
+    disconnect_vm_transports();
+    wifi_mgr_disconnect();
+    s_muse_napping = true;
+}
+
+void app_sumi_wifi_end(const char *joined) {
+    s_muse_napping = false;
+    if (joined[0]) {
+        s_none_nearby_us = 0;
+        ui_set_wifi(joined);
+        ui_set_status("wifi_connected");
+        persist_connected_wifi_channel();
+        if (config_is_provisioned()) xSemaphoreGive(s_muse_joined);
+    }
+    operation_gate_give();
 }

