+bool config_sumi_muse_load(sumi_muse_pair_t *pair) {
+    memset(pair, 0, sizeof(*pair));
+    nvs_handle_t h;
+    if (nvs_open(NS, NVS_READONLY, &h) != ESP_OK) return false;
+    size_t size = sizeof(*pair);
+    esp_err_t err = nvs_get_blob(h, MUSE_PAIR_KEY, pair, &size);
+    bool ok = false;
+    if (err == ESP_ERR_NVS_NOT_FOUND) {
+        ok = read_str(h, "access_token", pair->access, sizeof(pair->access));
+        read_str(h, "refresh_token", pair->refresh, sizeof(pair->refresh));
+    } else if (err == ESP_OK && size == sizeof(*pair)) {
+        ok = memchr(pair->access, 0, sizeof(pair->access)) &&
+             memchr(pair->refresh, 0, sizeof(pair->refresh)) && pair->reserved <= 1;
+    }
+    nvs_close(h);
+    return ok && pair->access[0];
+}
+
+bool config_sumi_muse_store(const sumi_muse_pair_t *pair) {
+    nvs_handle_t h;
+    if (nvs_open(NS, NVS_READWRITE, &h) != ESP_OK) return false;
+    esp_err_t err = nvs_set_blob(h, MUSE_PAIR_KEY, pair, sizeof(*pair));
+    if (err == ESP_OK) err = nvs_commit(h);
+    nvs_close(h);
+    return err == ESP_OK;
+}
