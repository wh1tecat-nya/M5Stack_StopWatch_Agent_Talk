+/* A local five-second recording test; never opens a Muse request. */
+static void sumi_test_microphone(void)
+{
+    const size_t frames = MUSE_AUDIO_RATE * 5;
+    int16_t *pcm = heap_caps_malloc(frames * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!pcm) { go_idle("録音テストのメモリー不足"); return; }
+    atomic_store(&s_mic_testing, true);
+    muse_state_set_asleep(false);
+    muse_state_poke();
+    muse_state_set_mode(MUSE_MODE_LISTENING);
+    size_t n = 0; rec_stats_t st = {0};
+    for (; n < frames && !atomic_load(&s_shutdown); n += MUSE_AUDIO_CHUNK) {
+        if (muse_audio_read(pcm + n, MUSE_AUDIO_CHUNK) != ESP_OK) break;
+        keep(&st, pcm + n, MUSE_AUDIO_CHUNK);
+        muse_state_set_level(muse_audio_level(pcm + n, MUSE_AUDIO_CHUNK));
+        muse_state_set_progress((float)n / frames);
+    }
+    double rms = n ? 10 * log10(st.acc / n / (32768.0 * 32768.0) + 1e-10) : -100;
+    ESP_LOGI(TAG, "local mic test: %.2fs rms %.1f dBFS peak %d clipped %d gain %d dB",
+             (double)n / MUSE_AUDIO_RATE, rms, st.peak, st.clipped, muse_settings_mic_gain());
+    muse_state_set_mode(MUSE_MODE_SPEAKING);
+    muse_state_set_caption("録音を再生しています");
+    for (size_t i = 0; i < n && !atomic_load(&s_shutdown); i += MUSE_AUDIO_CHUNK) {
+        muse_state_set_level(muse_audio_level(pcm + i, MUSE_AUDIO_CHUNK));
+        muse_audio_write(pcm + i, MUSE_AUDIO_CHUNK);
+    }
+    free(pcm);
+    muse_input_event_t ev;
+    while (xQueueReceive(s_queue, &ev, 0) == pdTRUE) muse_input_clear_call_pending(ev.mark);
+    atomic_store(&s_mic_testing, false);
+    muse_state_set_level(0);
+    go_idle(n == frames ? "録音テスト完了。Museには未送信" : "録音テストを中断しました");
+    pre_reset();
+}
